# ─────────────────────────────────────────────────────────────
# Configuración del Agente de WhatsApp de Gladymar
# Copia este archivo a `.env` y completa los valores reales.
# ─────────────────────────────────────────────────────────────

# --- Servidor ---
PORT=3000

# --- Claude (Anthropic) ---
# Obtén tu API key en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar. Opciones (de mayor a menor costo/capacidad):
#   claude-opus-4-8     -> máxima calidad
#   claude-sonnet-4-6   -> equilibrio (recomendado para alto volumen)
#   claude-haiku-4-5    -> más rápido y económico
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- WhatsApp Cloud API (Meta) ---
# Panel: https://developers.facebook.com -> tu App -> WhatsApp -> API Setup
# Token de acceso (permanente o temporal de pruebas)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# ID del número de teléfono (Phone Number ID), NO el número en sí
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Versión de la Graph API
WHATSAPP_API_VERSION=v21.0
# Token de verificación del webhook: lo inventas tú y lo pones igual
# en el panel de Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=gladymar-verifica-2026

# --- Administradores ---
# Número del Gerente General (acceso nacional total), formato internacional sin "+".
# Cualquier otro número de sucursal entra como administrador regional de su ciudad.
GERENTE_TELEFONO=59167401827

# --- Comportamiento ---
# Minutos de inactividad tras los cuales se reinicia la conversación de un usuario
SESSION_TTL_MINUTES=120

# --- Encuesta de satisfacción ---
# Enlace de la encuesta que se envía al finalizar la conversación
SURVEY_URL=https://gladymar.com.bo/encuesta/
# Minutos de inactividad tras los cuales se envía la encuesta (0 = desactivar)
SURVEY_DELAY_MINUTES=5

# --- Recursos descargables ---
# Enlace PÚBLICO y directo (PDF) al Manual de Asentamiento / Tríptico de Colocación.
# Si se define, el agente adjunta el PDF cuando el cliente lo solicita.
# Déjalo vacío hasta tener el archivo alojado públicamente.
MANUAL_ASENTAMIENTO_URL=

# --- Registro en Google Sheets ---
# URL del Web App de Google Apps Script ligado a tu hoja (ver README).
# Cada interacción del agente se registra como una fila. Vacío = desactivado.
SHEETS_WEBHOOK_URL=

# CRM de Prime (ingest en tiempo real). El token es secreto: cargalo en Railway.
CRM_INGEST_URL=https://www.primebusiness.live/api/crm/ingest
CRM_INGEST_TOKEN=
BACKFILL_KEY=
